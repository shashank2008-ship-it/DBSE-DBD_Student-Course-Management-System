{
  "name": "student-portal-pro",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/server.js",
    "server": "node server/server.js",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "start": "node server/server.js",
    "setup": "node scripts/setup.mjs",
    "db:setup": "node server/db/initDb.js",
    "test": "node --test server/tests/core.test.js",
    "test:integration": "node server/tests/integration.js"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "vite": "^5.4.6",
    "esbuild": "^0.27.3"
  },
  "engines": {
    "node": ">=20"
  }
}
