    {
      "name": "Cluster Enrollment and Official CGPA",
      "item": [
        {
          "name": "List clusters and offerings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clusters"
          }
        },
        {
          "name": "Choose cluster before enrollment",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clusters/students/{{studentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clusterId\": \"CLUSTER-2\"\n}"
            }
          }
        },
        {
          "name": "Admin set official CGPA",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clusters/students/{{studentId}}/cgpa",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 8.75,\n  \"reason\": \"Verified prior-semester transcript\"\n}"
            }
          }
        },
        {
          "name": "Admin restore calculated GPA",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/clusters/students/{{studentId}}/cgpa",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": null,\n  \"reason\": \"Restore grade-derived calculation\"\n}"
            }
          }
        },
        {
          "name": "Admin academic change history",
